<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet package metadata -->
    <PackageId>GitHttpBackend</PackageId>
    <!-- Version comes from VersionPrefix in Directory.Build.props, overridden by CI from the git tag. -->
    <Description>Host-agnostic bridge that runs Git's git-http-backend CGI and adapts it to a plain request/response model. The reusable core of a Git Smart HTTP server; no ASP.NET dependency.</Description>
    <PackageTags>git;http;git-http-backend;smart-http;cgi;server</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- git-http-backend is located at runtime, not shipped, so no XML docs on internals -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
